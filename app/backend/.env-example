# IDs de Usuário/Grupo para permissões de ficheiro em ambiente Docker/Linux.
# 1000 é um valor padrão comum.
UID=1000
GID=1000

# Define o ambiente da aplicação. Use 'development' para desenvolvimento local.
# Pode ser 'development' ou 'production'
DJANGO_ENV=development 

# ATENÇÃO: Gere uma nova chave secreta para o seu ambiente .env
# Nunca use esta chave de exemplo em produção.
SECRET_KEY='coloque_sua_chave_secreta_aqui'

# Hosts/domínios permitidos para esta aplicação Django.
ALLOWED_HOSTS='localhost,127.0.0.1'

# --- Configurações do Banco de Dados PostgreSQL ---
# Altere os valores abaixo com as suas credenciais de banco de dados no seu .env
POSTGRES_DB=nome_do_seu_banco
POSTGRES_USER=nome_do_seu_usuario
POSTGRES_PASSWORD=sua_senha_forte_aqui

# Deploy Render: o Blueprint preenche DATABASE_URL e SECRET_KEY automaticamente.
# Para desenvolvimento local, mantenha USE_SUPABASE_STORAGE=false.
POSTGRES_HOST=db
POSTGRES_PORT=5432
ALLOW_DEMO_DATA=false
DEMO_PASSWORD=
USE_SUPABASE_STORAGE=false
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# CORS_ALLOWED_ORIGINS=https://seu-painel.onrender.com
# CSRF_TRUSTED_ORIGINS=https://seu-painel.onrender.com
# SUPABASE_STORAGE_BUCKET=janupoints-media
# SUPABASE_S3_ENDPOINT_URL=https://SEU-PROJETO.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=regiao-exibida-no-supabase
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
